{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "splitline/core",
    "description": "Core telemetry contracts, immutable DTOs, rate limiting, and analytics math for Splitline.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/splitline-php/ingest",
    "support": {
        "issues": "https://github.com/splitline-php/ingest/issues",
        "source": "https://github.com/splitline-php/ingest"
    },
    "require": {
        "php": "^8.5",
        "nesbot/carbon": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Splitline\\Core\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
